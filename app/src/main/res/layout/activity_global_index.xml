<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8EDF2">

    <!-- Banner -->
    <LinearLayout
        android:id="@+id/headerGlobal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/md_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:text="Base de Tickets"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/statsTotalTickets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textSize="13sp"
            android:textColor="#BBDEFB" />

        <TextView
            android:id="@+id/btnGlobalConsecutivos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="🔍 Verificar consecutivos faltantes"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:background="#E3F2FD"
            android:gravity="center" />

    </LinearLayout>

    <!-- Cabecera de columnas -->
    <LinearLayout
        android:id="@+id/tableHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#D0D8E4"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@+id/headerGlobal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="BOLETA"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="@color/md_on_surface_variant"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FECHA DE RECOGIDA"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="@color/md_on_surface_variant"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <ListView
        android:id="@+id/ticketIndexList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#E8EDF2"
        android:divider="#00000000"
        android:dividerHeight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/tableHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
