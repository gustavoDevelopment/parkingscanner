<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <!-- Boleta -->
        <TextView
            android:id="@+id/itemBoleta"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_surface"
            android:fontFamily="monospace" />

        <!-- Fecha de recogida -->
        <TextView
            android:id="@+id/itemScanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/md_on_surface_variant" />

        <!-- Badge duplicado -->
        <TextView
            android:id="@+id/itemDuplicateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DUP"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FF9800"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/chip_bg_anulado"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
